# Supabase — 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
# Supabase 대시보드 → Settings → API → Project URL / service_role key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 식약처 공공데이터 DUR API — 서버 전용
# 발급: https://www.data.go.kr → "의약품 DUR 품목정보 서비스" 신청
DUR_API_KEY=your_api_key_here
